<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studysync.desktop.WebViewController"
            stylesheets="@desktop.css">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="toolbar">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="8"/>
                </padding>
                <Button fx:id="backButton" text="Back" onAction="#goBack" />
                <Button fx:id="forwardButton" text="Forward" onAction="#goForward" />
                <Button text="Reload" onAction="#reload" />
                <Button text="Home" onAction="#goHome" />
                <TextField fx:id="addressField" editable="false" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="status-bar">
                <padding>
                    <Insets top="4" right="8" bottom="4" left="8"/>
                </padding>
                <ProgressIndicator fx:id="progressIndicator" maxHeight="16" maxWidth="16" visible="false" />
                <Label fx:id="statusLabel" text="Starting StudySync..." />
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contentPane">
            <WebView fx:id="webView" />
            <VBox fx:id="errorPane" alignment="CENTER" maxWidth="420" spacing="12" visible="false">
                <Label text="StudySync is unavailable" styleClass="error-title" />
                <Label fx:id="errorMessage" alignment="CENTER" wrapText="true" />
                <Label text="Start MySQL and Tomcat, then retry." wrapText="true" />
                <Button text="Retry" onAction="#retry" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
